# NocoDB — self-hosted store for coming-soon email signups.
NOCODB_API_URL="https://nocodb.theswisscheese.com"
# API token (secret) — sent as the `xc-token` header.
# NocoDB → Account Settings → API Tokens → Create.
NOCODB_API_TOKEN=""
# Target table id (open the table in NocoDB; id is in the URL / table Details).
NOCODB_TABLE_ID=""
# Column that holds the email address (optional, defaults to "Email").
NOCODB_EMAIL_FIELD="Email"

# Resend — sends a "new signup" notification email (optional).
# A send-only (sending_access) key is sufficient here. https://resend.com/api-keys
RESEND_API_KEY=""
# Where signup alerts are delivered.
NOTIFICATIONS_RECIPIENT=""
# From address for alerts (optional). Use a verified-domain sender for reliable
# delivery to any recipient; the default reliably reaches only your own Resend
# account email.
NOTIFICATIONS_FROM="Ensemblr <onboarding@resend.dev>"
