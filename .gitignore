# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent scratch output — transcripts, page snapshots, critique notes and local
# tool config written by coding agents while working in this repo. Biome runs
# with `vcs.useIgnoreFile`, so anything left out of this list also gets linted.
/.playwright-mcp/
/.impeccable/
/.codex/
/.context/
/.claude/settings.local.json
